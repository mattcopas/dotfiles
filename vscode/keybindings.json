// Place your key bindings in this file to override the defaults
[
  {
    "key": "ctrl+g",
    "command": "workbench.action.focusActiveEditorGroup",
    "when": "!editorFocus"
  },  // Terminal focus
  {
    "key": "ctrl+`",
    "command": "workbench.action.terminal.focus",
    "when": "!terminalFocus"
  },
  {
    "key": "ctrl+`",
    "command": "workbench.action.focusActiveEditorGroup",
    "when": "terminalFocus"
  },

  // Increase buffer sizes (could be improved)
  {
    "key": "cmd+shift+down",
    "command": "workbench.action.increaseViewHeight"
  },
  {
    "key": "cmd+shift+up",
    "command": "workbench.action.decreaseViewHeight"
  },
  {
    "key": "cmd+shift+left",
    "command": "workbench.action.increaseViewWidth"
  },
  {
    "key": "cmd+shift+right",
    "command": "workbench.action.decreaseViewWidth"
  },

  // Toggle entire activity bar
  {
    "key": "cmd+shift+b",
    "command": "workbench.action.toggleActivityBarVisibility"
  },

  // Switch between terminal windows
  {
    "key": "cmd+]",
    "command": "workbench.action.terminal.focusNextPane"
  },
  {
    "key": "cmd+[",
    "command": "workbench.action.terminal.focusPreviousPane"
  },

  // Split terminal horisontally
  {
    "key": "cmd+d",
    "command": "workbench.action.terminal.split",
    "when": "terminalFocus"
  },

  // File explorer keybindings
  {
    "key": "enter",
    "command": "explorer.newFile",
    "when": "filesExplorerFocus"
  },
  {
    "key": "ctrl+enter",
    "command": "explorer.newFolder",
    "when": "filesExplorerFocus"
  },
  {
    "key": "F2",
    "command": "renameFile",
    "when": "filesExplorerFocus"
  },

  // Org and its agenda own TAB. These live here rather than in the orgflow extension,
  // because a user keybinding always beats VSCodeVim's own TAB binding.
  {
    "key": "tab",
    "command": "orgflow.org.cycle",
    "when": "editorTextFocus && editorLangId == 'org' && vim.mode == 'Normal'"
  },
  {
    "key": "shift+tab",
    "command": "orgflow.org.globalCycle",
    "when": "editorTextFocus && editorLangId == 'org' && vim.mode == 'Normal'"
  },
  {
    "key": "tab",
    "command": "orgflow.agenda.openBeside",
    "when": "editorTextFocus && editorLangId == 'org-agenda' && vim.mode == 'Normal'"
  },
  {
    "key": "enter",
    "command": "orgflow.agenda.open",
    "when": "editorTextFocus && editorLangId == 'org-agenda' && vim.mode == 'Normal'"
  },

  // Magic keybindings
  // from https://marketplace.visualstudio.com/items?itemName=kahole.magit
  {
    "key": "tab",
    "command": "extension.vim_tab",
    "when": "editorFocus && vim.active && !inDebugRepl && vim.mode != 'Insert' && editorLangId != 'magit' && editorLangId != 'org' && editorLangId != 'org-agenda'"
  },
  {
    "key": "tab",
    "command": "-extension.vim_tab",
    "when": "editorFocus && vim.active && !inDebugRepl && vim.mode != 'Insert'"
  },
  {
    "key": "x",
    "command": "magit.discard-at-point",
    "when": "editorTextFocus && editorLangId == 'magit' && vim.mode =~ /^(?!SearchInProgressMode|CommandlineInProgress).*$/"
  },
  { "key": "k", "command": "-magit.discard-at-point" },
  {
    "key": "-",
    "command": "magit.reverse-at-point",
    "when": "editorTextFocus && editorLangId == 'magit' && vim.mode =~ /^(?!SearchInProgressMode|CommandlineInProgress).*$/"
  },
  { "key": "v", "command": "-magit.reverse-at-point" },
  {
    "key": "shift+-",
    "command": "magit.reverting",
    "when": "editorTextFocus && editorLangId == 'magit' && vim.mode =~ /^(?!SearchInProgressMode|CommandlineInProgress).*$/"
  },
  { "key": "shift+v", "command": "-magit.reverting" },
  // { "key": "shift+o", "command": "magit.resetting", "when": "editorTextFocus && editorLangId == 'magit' && vim.mode =~ /^(?!SearchInProgressMode|CommandlineInProgress).*$/" },
  // { "key": "shift+x", "command": "-magit.resetting" },
  { "key": "x", "command": "-magit.reset-mixed" },
  { "key": "ctrl+u x", "command": "-magit.reset-hard" },

  // use emacs-style C-g to exit insert mode when writing git commit messages
  { "key": "ctrl+g", "command": "extension.vim_ctrl+c", "when": "editorTextFocus && editorLangId == 'git-commit'"}
]

