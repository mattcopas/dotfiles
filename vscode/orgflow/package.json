{
  "name": "orgflow",
  "displayName": "Orgflow",
  "description": "Org mode, agenda, journal, which-key menus and project switching for VS Code, with a Doom One theme.",
  "version": "0.1.0",
  "publisher": "mcopas-local",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Themes",
    "Keymaps",
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:org"
  ],
  "contributes": {
    "languages": [
      {
        "id": "org",
        "aliases": [
          "Org",
          "org"
        ],
        "extensions": [
          ".org"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "org-agenda",
        "aliases": [
          "Org Agenda"
        ],
        "extensions": [
          ".org-agenda"
        ]
      }
    ],
    "grammars": [
      {
        "language": "org",
        "scopeName": "source.org",
        "path": "./syntaxes/org.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.bash": "shellscript",
          "meta.embedded.block.c": "c",
          "meta.embedded.block.cpp": "cpp",
          "meta.embedded.block.css": "css",
          "meta.embedded.block.dockerfile": "dockerfile",
          "meta.embedded.block.go": "go",
          "meta.embedded.block.html": "html",
          "meta.embedded.block.java": "java",
          "meta.embedded.block.javascript": "javascript",
          "meta.embedded.block.json": "json",
          "meta.embedded.block.markdown": "markdown",
          "meta.embedded.block.php": "php",
          "meta.embedded.block.python": "python",
          "meta.embedded.block.ruby": "ruby",
          "meta.embedded.block.rust": "rust",
          "meta.embedded.block.sql": "sql",
          "meta.embedded.block.typescript": "typescript",
          "meta.embedded.block.xml": "xml",
          "meta.embedded.block.yaml": "yaml"
        }
      },
      {
        "language": "org-agenda",
        "scopeName": "source.org-agenda",
        "path": "./syntaxes/org-agenda.tmLanguage.json"
      }
    ],
    "themes": [
      {
        "label": "Doom One",
        "uiTheme": "vs-dark",
        "path": "./themes/doom-one-color-theme.json"
      }
    ],
    "commands": [
      {
        "command": "orgflow.whichKey",
        "title": "Orgflow: Open Leader Menu"
      },
      {
        "command": "orgflow.switchProject",
        "title": "Orgflow: Switch Project"
      },
      {
        "command": "orgflow.agenda",
        "title": "Orgflow: Open Agenda"
      },
      {
        "command": "orgflow.capture",
        "title": "Orgflow: Capture"
      },
      {
        "command": "orgflow.journal.newEntry",
        "title": "Orgflow: New Journal Entry"
      },
      {
        "command": "orgflow.org.setTodo",
        "title": "Orgflow: Set TODO State"
      },
      {
        "command": "orgflow.org.schedule",
        "title": "Orgflow: Schedule"
      },
      {
        "command": "orgflow.org.scheduleToday",
        "title": "Orgflow: Schedule for Today"
      },
      {
        "command": "orgflow.org.scheduleTomorrow",
        "title": "Orgflow: Schedule for Tomorrow"
      },
      {
        "command": "orgflow.org.deadline",
        "title": "Orgflow: Set Deadline"
      },
      {
        "command": "orgflow.org.setTags",
        "title": "Orgflow: Set Tags"
      },
      {
        "command": "orgflow.org.priorityUp",
        "title": "Orgflow: Priority Up"
      },
      {
        "command": "orgflow.org.priorityDown",
        "title": "Orgflow: Priority Down"
      },
      {
        "command": "orgflow.org.cycle",
        "title": "Orgflow: Cycle Fold or Next Table Cell"
      },
      {
        "command": "orgflow.org.shiftSelectionRight",
        "title": "Orgflow: Demote Selected Headings, or Indent"
      },
      {
        "command": "orgflow.org.shiftSelectionLeft",
        "title": "Orgflow: Promote Selected Headings, or Unindent"
      },
      {
        "command": "orgflow.org.globalCycle",
        "title": "Orgflow: Cycle All Folds"
      },
      {
        "command": "orgflow.org.insertLink",
        "title": "Orgflow: Insert Link"
      },
      {
        "command": "orgflow.org.openLink",
        "title": "Orgflow: Open Link at Cursor"
      },
      {
        "command": "orgflow.org.alignTable",
        "title": "Orgflow: Align Table"
      }
    ],
    "keybindings": [
      {
        "key": "space",
        "command": "runCommands",
        "when": "editorTextFocus && vim.active && vim.mode =~ /^(Normal|Visual|VisualLine|VisualBlock)$/",
        "args": {
          "commands": [
            "workbench.action.focusStatusBar",
            {
              "command": "orgflow.whichKey",
              "args": "armed"
            }
          ]
        }
      },
      {
        "key": "space",
        "command": "orgflow.whichKey",
        "when": "!editorTextFocus && !inputFocus && !terminalFocus && !inQuickOpen && !listFocus"
      },
      {
        "key": "ctrl+g",
        "command": "workbench.action.closeQuickOpen",
        "when": "inQuickOpen"
      },
      {
        "key": "ctrl+j",
        "command": "workbench.action.quickOpenSelectNext",
        "when": "inQuickOpen"
      },
      {
        "key": "ctrl+k",
        "command": "workbench.action.quickOpenSelectPrevious",
        "when": "inQuickOpen"
      },
      {
        "key": "tab",
        "command": "orgflow.org.cycle",
        "when": "editorTextFocus && editorLangId == org && vim.mode == 'Normal'"
      },
      {
        "key": "tab",
        "command": "orgflow.org.cycle",
        "when": "editorTextFocus && editorLangId == org && orgflow.inTable && vim.mode == 'Insert' && !suggestWidgetVisible && !inSnippetMode"
      },
      {
        "key": "shift+tab",
        "command": "orgflow.org.globalCycle",
        "when": "editorTextFocus && editorLangId == org && vim.mode == 'Normal'"
      },
      {
        "key": "enter",
        "command": "orgflow.org.openLink",
        "when": "editorTextFocus && editorLangId == org && orgflow.onLink && vim.mode == 'Normal'"
      },
      {
        "key": "alt+j",
        "command": "orgflow.org.moveDown",
        "when": "editorTextFocus && editorLangId == org && vim.mode == 'Normal'"
      },
      {
        "key": "alt+k",
        "command": "orgflow.org.moveUp",
        "when": "editorTextFocus && editorLangId == org && vim.mode == 'Normal'"
      },
      {
        "key": "shift+. shift+.",
        "command": "orgflow.org.demote",
        "when": "editorTextFocus && editorLangId == org && orgflow.onHeading && vim.mode == 'Normal'"
      },
      {
        "key": "shift+, shift+,",
        "command": "orgflow.org.promote",
        "when": "editorTextFocus && editorLangId == org && orgflow.onHeading && vim.mode == 'Normal'"
      },
      {
        "key": "shift+.",
        "command": "orgflow.org.shiftSelectionRight",
        "when": "editorTextFocus && editorLangId == org && (vim.mode == 'Visual' || vim.mode == 'VisualLine')"
      },
      {
        "key": "shift+,",
        "command": "orgflow.org.shiftSelectionLeft",
        "when": "editorTextFocus && editorLangId == org && (vim.mode == 'Visual' || vim.mode == 'VisualLine')"
      },
      {
        "key": "alt+h",
        "command": "orgflow.org.promote",
        "when": "editorTextFocus && editorLangId == org && vim.mode == 'Normal'"
      },
      {
        "key": "alt+l",
        "command": "orgflow.org.demote",
        "when": "editorTextFocus && editorLangId == org && vim.mode == 'Normal'"
      },
      {
        "key": "alt+shift+h",
        "command": "orgflow.org.promoteSubtree",
        "when": "editorTextFocus && editorLangId == org && vim.mode == 'Normal'"
      },
      {
        "key": "alt+shift+l",
        "command": "orgflow.org.demoteSubtree",
        "when": "editorTextFocus && editorLangId == org && vim.mode == 'Normal'"
      },
      {
        "key": "enter",
        "command": "orgflow.agenda.open",
        "when": "editorTextFocus && editorLangId == org-agenda && vim.mode == 'Normal'"
      },
      {
        "key": "tab",
        "command": "orgflow.agenda.openBeside",
        "when": "editorTextFocus && editorLangId == org-agenda && vim.mode == 'Normal'"
      },
      {
        "key": "t",
        "command": "orgflow.org.setTodo",
        "when": "editorTextFocus && editorLangId == org-agenda && vim.mode == 'Normal'"
      },
      {
        "key": "r",
        "command": "orgflow.agenda.refresh",
        "when": "editorTextFocus && editorLangId == org-agenda && vim.mode == 'Normal'"
      },
      {
        "key": "q",
        "command": "orgflow.agenda.quit",
        "when": "editorTextFocus && editorLangId == org-agenda && vim.mode == 'Normal'"
      },
      {
        "key": "]",
        "command": "orgflow.agenda.later",
        "when": "editorTextFocus && editorLangId == org-agenda && vim.mode == 'Normal'"
      },
      {
        "key": "[",
        "command": "orgflow.agenda.earlier",
        "when": "editorTextFocus && editorLangId == org-agenda && vim.mode == 'Normal'"
      },
      {
        "key": "shift+h",
