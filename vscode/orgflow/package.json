    "configuration": {
      "title": "Orgflow",
      "properties": {
        "orgflow.todoKeywords": {
          "type": "array",
          "description": "TODO keyword sequences in org notation, with | before the done states.",
          "default": [
            [
              "TODO(t)",
              "IN PROGRESS(p)",
              "IN REVIEW(r)",
              "LOOP",
              "STRT(s)",
              "WAIT(w)",
              "HOLD(h)",
              "IDEA(i)",
              "|",
              "DONE(d)",
              "KILL(k)"
            ],
            [
              "[ ](T)",
              "[-](S)",
              "[?](W)",
              "|",
              "[X](D)"
            ],
            [
              "|",
              "OKAY(o)",
              "YES(y)",
              "NO(n)"
            ]
          ]
        },
        "orgflow.agenda.files": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Org files or directories for the agenda. Directories aren't searched recursively, and dotfiles are skipped, matching org-agenda-files.",
          "default": [
            "~/git/private-personal",
            "~/git/private-client",
            "~/git/private-work"
          ]
        },
        "orgflow.agenda.width": {
          "type": "number",
          "description": "Column that agenda tags right-align to.",
          "default": 100
        },
        "orgflow.agenda.deadlineWarningDays": {
          "type": "number",
          "default": 14,
          "description": "Days before a deadline that it starts appearing on today."
        },
        "orgflow.agenda.views": {
          "type": "array",
          "description": "Custom agenda views, each a key, a description and a list of blocks.",
          "default": [
            {
              "key": "c",
              "description": "Simple agenda view",
              "blocks": [
                {
                  "type": "tags",
                  "match": "PRIORITY=\"A\"",
                  "header": "High priority unfinished tasks",
                  "skip": [
                    {
                      "if": "todo",
                      "value": "done"
                    }
                  ]
                },
                {
                  "type": "agenda"
                },
                {
                  "type": "alltodo",
                  "skip": [
                    {
                      "if": "priority",
                      "value": "A",
                      "scope": "subtree"
                    },
                    {
                      "if": "scheduled"
                    },
                    {
                      "if": "deadline"
                    }
                  ]
                }
              ]
            },
            {
              "key": "w",
              "description": "Work agenda view",
              "blocks": [
                {
                  "type": "tags",
                  "match": "+work+PRIORITY=\"A\"",
                  "header": "High priority unfinished tasks",
                  "skip": [
                    {
                      "if": "todo",
                      "value": [
                        "WAIT",
                        "KILL",
                        "DONE"
                      ]
                    }
                  ]
                },
                {
                  "type": "tags-todo",
                  "match": "+work",
                  "header": "Blocked tasks",
                  "skip": [
                    {
                      "if": "todo",
                      "value": [
                        "TODO",
                        "IN PROGRESS",
                        "IN REVIEW",
                        "KILL",
                        "DONE"
                      ]
                    }
                  ]
                },
                {
                  "type": "tags",
                  "match": "+SCHEDULED=\"<today>\"",
                  "header": "Today's tasks",
                  "skip": [
                    {
                      "if": "todo",
                      "value": [
                        "DONE",
                        "KILL"
                      ]
                    }
                  ]
                },
                {
                  "type": "tags",
                  "match": "+SCHEDULED=\"<today>\"",
                  "header": "Today's completed tasks",
                  "skip": [
                    {
                      "if": "nottodo",
                      "value": [
                        "DONE"
                      ]
                    }
                  ]
                },
                {
                  "type": "tags",
                  "match": "+SCHEDULED=\"<tomorrow>\"",
                  "header": "Tomorrow's tasks"
                },
                {
                  "type": "tags-todo",
                  "match": "+work",
                  "skip": [
                    {
                      "if": "priority",
                      "value": "A",
                      "scope": "subtree"
                    },
                    {
                      "if": "nottodo",
                      "value": [
                        "TODO",
                        "IN PROGRESS"
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "key": "p",
              "description": "Personal agenda view",
              "blocks": [
                {
                  "type": "tags",
                  "match": "+personal+PRIORITY=\"A\"",
                  "header": "High priority unfinished tasks",
                  "skip": [
                    {
                      "if": "todo",
                      "value": "done"
                    }
                  ]
                },
                {
                  "type": "tags-todo",
                  "match": "+personal",
                  "skip": [
                    {
                      "if": "priority",
                      "value": "A",
                      "scope": "subtree"
                    },
                    {
                      "if": "todo",
                      "value": "done"
                    }
                  ]
                }
              ]
            }
          ]
        },
