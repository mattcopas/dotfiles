{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Org",
  "scopeName": "source.org",
  "patterns": [
    {
      "include": "#headings"
    },
    {
      "include": "#blocks"
    },
    {
      "include": "#keywordLines"
    },
    {
      "include": "#drawer"
    },
    {
      "include": "#planning"
    },
    {
      "include": "#comment"
    },
    {
      "include": "#table"
    },
    {
      "include": "#inline"
    }
  ],
  "repository": {
    "headings": {
      "patterns": [
        {
          "match": "^(\\*{1})( )(.*)$",
          "name": "markup.heading.1.org",
          "captures": {
            "3": {
              "patterns": [
                {
                  "include": "#headingInner"
                }
              ]
            }
          }
        },
        {
          "match": "^(\\*{2})( )(.*)$",
          "name": "markup.heading.2.org",
          "captures": {
            "3": {
              "patterns": [
                {
                  "include": "#headingInner"
                }
              ]
            }
          }
        },
        {
          "match": "^(\\*{3})( )(.*)$",
          "name": "markup.heading.3.org",
          "captures": {
            "3": {
              "patterns": [
                {
                  "include": "#headingInner"
                }
              ]
            }
          }
        },
        {
          "match": "^(\\*{4})( )(.*)$",
          "name": "markup.heading.4.org",
          "captures": {
            "3": {
              "patterns": [
                {
                  "include": "#headingInner"
                }
              ]
            }
          }
        },
        {
          "match": "^(\\*{5})( )(.*)$",
          "name": "markup.heading.5.org",
          "captures": {
            "3": {
              "patterns": [
                {
                  "include": "#headingInner"
                }
              ]
            }
          }
        },
        {
          "match": "^(\\*{6})( )(.*)$",
          "name": "markup.heading.6.org",
          "captures": {
            "3": {
              "patterns": [
                {
                  "include": "#headingInner"
                }
              ]
            }
          }
        },
        {
          "match": "^(\\*{7})( )(.*)$",
          "name": "markup.heading.7.org",
          "captures": {
            "3": {
              "patterns": [
                {
                  "include": "#headingInner"
                }
              ]
            }
          }
        },
        {
          "match": "^(\\*{8,})( )(.*)$",
          "name": "markup.heading.8.org",
          "captures": {
            "3": {
              "patterns": [
                {
                  "include": "#headingInner"
                }
              ]
            }
          }
        }
      ]
    },
    "headingInner": {
      "patterns": [
        {
          "match": "(?:^|[ \\t]+)(:[\\w@#%:]+:)[ \\t]*$",
          "captures": {
            "1": {
              "name": "entity.name.tag.org"
            }
          }
        },
        {
          "include": "#inline"
        }
      ]
    },
    "blocks": {
      "patterns": [
        {
          "begin": "^\\s*(?i:#\\+begin_src)\\s+(?:sh|bash|shell|zsh)\\b.*$",
          "end": "^\\s*(?i:#\\+end_src)\\s*$",
          "beginCaptures": {
            "0": {
              "name": "meta.block.delimiter.org"
            }
          },
          "endCaptures": {
            "0": {
              "name": "meta.block.delimiter.org"
            }
          },
          "contentName": "meta.embedded.block.bash",
          "patterns": [
            {
              "include": "source.shell"
            }
          ]
        },
        {
          "begin": "^\\s*(?i:#\\+begin_src)\\s+(?:python|py)\\b.*$",
          "end": "^\\s*(?i:#\\+end_src)\\s*$",
          "beginCaptures": {
            "0": {
              "name": "meta.block.delimiter.org"
            }
          },
          "endCaptures": {
            "0": {
              "name": "meta.block.delimiter.org"
            }
          },
          "contentName": "meta.embedded.block.python",
          "patterns": [
            {
              "include": "source.python"
            }
          ]
        },
        {
          "begin": "^\\s*(?i:#\\+begin_src)\\s+(?:js|javascript|jsx)\\b.*$",
          "end": "^\\s*(?i:#\\+end_src)\\s*$",
          "beginCaptures": {
            "0": {
              "name": "meta.block.delimiter.org"
            }
          },
          "endCaptures": {
            "0": {
              "name": "meta.block.delimiter.org"
            }
          },
          "contentName": "meta.embedded.block.javascript",
          "patterns": [
            {
              "include": "source.js"
            }
          ]
        },
        {
          "begin": "^\\s*(?i:#\\+begin_src)\\s+(?:ts|typescript|tsx)\\b.*$",
          "end": "^\\s*(?i:#\\+end_src)\\s*$",
          "beginCaptures": {
            "0": {
              "name": "meta.block.delimiter.org"
            }
          },
          "endCaptures": {
            "0": {
              "name": "meta.block.delimiter.org"
            }
          },
          "contentName": "meta.embedded.block.typescript",
          "patterns": [
            {
              "include": "source.ts"
            }
          ]
        },
        {
          "begin": "^\\s*(?i:#\\+begin_src)\\s+(?:json)\\b.*$",
          "end": "^\\s*(?i:#\\+end_src)\\s*$",
          "beginCaptures": {
            "0": {
              "name": "meta.block.delimiter.org"
            }
          },
          "endCaptures": {
            "0": {
              "name": "meta.block.delimiter.org"
            }
          },
          "contentName": "meta.embedded.block.json",
          "patterns": [
            {
              "include": "source.json"
            }
          ]
        },
        {
          "begin": "^\\s*(?i:#\\+begin_src)\\s+(?:ya?ml)\\b.*$",
          "end": "^\\s*(?i:#\\+end_src)\\s*$",
          "beginCaptures": {
            "0": {
              "name": "meta.block.delimiter.org"
            }
          },
          "endCaptures": {
            "0": {
              "name": "meta.block.delimiter.org"
            }
          },
          "contentName": "meta.embedded.block.yaml",
          "patterns": [
            {
              "include": "source.yaml"
            }
          ]
        },
        {
          "begin": "^\\s*(?i:#\\+begin_src)\\s+(?:java)\\b.*$",
          "end": "^\\s*(?i:#\\+end_src)\\s*$",
          "beginCaptures": {
            "0": {
              "name": "meta.block.delimiter.org"
            }
          },
          "endCaptures": {
            "0": {
              "name": "meta.block.delimiter.org"
            }
          },
          "contentName": "meta.embedded.block.java",
          "patterns": [
            {
              "include": "source.java"
            }
          ]
        },
        {
          "begin": "^\\s*(?i:#\\+begin_src)\\s+(?:php)\\b.*$",
          "end": "^\\s*(?i:#\\+end_src)\\s*$",
          "beginCaptures": {
            "0": {
              "name": "meta.block.delimiter.org"
            }
          },
          "endCaptures": {
            "0": {
              "name": "meta.block.delimiter.org"
            }
          },
          "contentName": "meta.embedded.block.php",
          "patterns": [
            {
              "include": "source.php"
            }
          ]
        },
        {
          "begin": "^\\s*(?i:#\\+begin_src)\\s+(?:sql)\\b.*$",
          "end": "^\\s*(?i:#\\+end_src)\\s*$",
          "beginCaptures": {
            "0": {
              "name": "meta.block.delimiter.org"
            }
          },
          "endCaptures": {
            "0": {
              "name": "meta.block.delimiter.org"
            }
          },
          "contentName": "meta.embedded.block.sql",
          "patterns": [
            {
              "include": "source.sql"
            }
          ]
        },
        {
          "begin": "^\\s*(?i:#\\+begin_src)\\s+(?:go)\\b.*$",
          "end": "^\\s*(?i:#\\+end_src)\\s*$",
          "beginCaptures": {
            "0": {
              "name": "meta.block.delimiter.org"
            }
          },
          "endCaptures": {
            "0": {
              "name": "meta.block.delimiter.org"
            }
          },
          "contentName": "meta.embedded.block.go",
          "patterns": [
            {
              "include": "source.go"
            }
          ]
        },
        {
          "begin": "^\\s*(?i:#\\+begin_src)\\s+(?:rust)\\b.*$",
          "end": "^\\s*(?i:#\\+end_src)\\s*$",
          "beginCaptures": {
            "0": {
              "name": "meta.block.delimiter.org"
            }
          },
          "endCaptures": {
            "0": {
              "name": "meta.block.delimiter.org"
            }
          },
          "contentName": "meta.embedded.block.rust",
          "patterns": [
            {
              "include": "source.rust"
            }
          ]
        },
        {
          "begin": "^\\s*(?i:#\\+begin_src)\\s+(?:c)\\b.*$",
          "end": "^\\s*(?i:#\\+end_src)\\s*$",
          "beginCaptures": {
            "0": {
              "name": "meta.block.delimiter.org"
            }
          },
          "endCaptures": {
            "0": {
              "name": "meta.block.delimiter.org"
            }
          },
          "contentName": "meta.embedded.block.c",
          "patterns": [
            {
              "include": "source.c"
            }
          ]
        },
        {
          "begin": "^\\s*(?i:#\\+begin_src)\\s+(?:c\\+\\+|cpp)\\b.*$",
          "end": "^\\s*(?i:#\\+end_src)\\s*$",
          "beginCaptures": {
            "0": {
              "name": "meta.block.delimiter.org"
            }
          },
          "endCaptures": {
            "0": {
              "name": "meta.block.delimiter.org"
            }
          },
          "contentName": "meta.embedded.block.cpp",
          "patterns": [
            {
              "include": "source.cpp"
            }
          ]
        },
        {
          "begin": "^\\s*(?i:#\\+begin_src)\\s+(?:css)\\b.*$",
          "end": "^\\s*(?i:#\\+end_src)\\s*$",
          "beginCaptures": {
            "0": {
              "name": "meta.block.delimiter.org"
            }
          },
          "endCaptures": {
            "0": {
              "name": "meta.block.delimiter.org"
            }
          },
          "contentName": "meta.embedded.block.css",
          "patterns": [
            {
              "include": "source.css"
            }
          ]
        },
        {
          "begin": "^\\s*(?i:#\\+begin_src)\\s+(?:html)\\b.*$",
          "end": "^\\s*(?i:#\\+end_src)\\s*$",
          "beginCaptures": {
            "0": {
              "name": "meta.block.delimiter.org"
            }
          },
          "endCaptures": {
            "0": {
              "name": "meta.block.delimiter.org"
            }
          },
          "contentName": "meta.embedded.block.html",
          "patterns": [
            {
              "include": "text.html.basic"
            }
          ]
        },
        {
          "begin": "^\\s*(?i:#\\+begin_src)\\s+(?:xml)\\b.*$",
          "end": "^\\s*(?i:#\\+end_src)\\s*$",
          "beginCaptures": {
            "0": {
              "name": "meta.block.delimiter.org"
            }
          },
          "endCaptures": {
            "0": {
              "name": "meta.block.delimiter.org"
            }
          },
          "contentName": "meta.embedded.block.xml",
          "patterns": [
            {
              "include": "text.xml"
            }
          ]
        },
        {
          "begin": "^\\s*(?i:#\\+begin_src)\\s+(?:markdown|md)\\b.*$",
          "end": "^\\s*(?i:#\\+end_src)\\s*$",
          "beginCaptures": {
            "0": {
              "name": "meta.block.delimiter.org"
            }
          },
          "endCaptures": {
            "0": {
              "name": "meta.block.delimiter.org"
            }
          },
          "contentName": "meta.embedded.block.markdown",
          "patterns": [
            {
              "include": "text.html.markdown"
            }
          ]
        },
        {
          "begin": "^\\s*(?i:#\\+begin_src)\\s+(?:ruby)\\b.*$",
          "end": "^\\s*(?i:#\\+end_src)\\s*$",
          "beginCaptures": {
            "0": {
              "name": "meta.block.delimiter.org"
            }
          },
          "endCaptures": {
            "0": {
              "name": "meta.block.delimiter.org"
            }
          },
          "contentName": "meta.embedded.block.ruby",
          "patterns": [
            {
              "include": "source.ruby"
            }
          ]
        },
        {
          "begin": "^\\s*(?i:#\\+begin_src)\\s+(?:dockerfile)\\b.*$",
          "end": "^\\s*(?i:#\\+end_src)\\s*$",
          "beginCaptures": {
            "0": {
              "name": "meta.block.delimiter.org"
            }
          },
          "endCaptures": {
            "0": {
              "name": "meta.block.delimiter.org"
            }
          },
          "contentName": "meta.embedded.block.dockerfile",
          "patterns": [
            {
              "include": "source.dockerfile"
            }
          ]
        },
        {
          "begin": "^\\s*(?i:#\\+begin_src)\\b.*$",
          "end": "^\\s*(?i:#\\+end_src)\\s*$",
          "beginCaptures": {
            "0": {
              "name": "meta.block.delimiter.org"
            }
          },
          "endCaptures": {
            "0": {
              "name": "meta.block.delimiter.org"
            }
          },
          "contentName": "markup.fenced_code.block.org"
        },
        {
          "begin": "^\\s*(?i:#\\+begin_quote)\\b.*$",
          "end": "^\\s*(?i:#\\+end_quote)\\s*$",
          "beginCaptures": {
            "0": {
              "name": "meta.block.delimiter.org"
            }
          },
          "endCaptures": {
            "0": {
              "name": "meta.block.delimiter.org"
            }
          },
          "contentName": "markup.quote.org"
        },
        {
          "begin": "^\\s*(?i:#\\+begin_(example|export))\\b.*$",
          "end": "^\\s*(?i:#\\+end_(example|export))\\s*$",
          "beginCaptures": {
            "0": {
              "name": "meta.block.delimiter.org"
            }
          },
          "endCaptures": {
            "0": {
              "name": "meta.block.delimiter.org"
            }
          },
          "contentName": "markup.fenced_code.block.org"
        },
        {
          "begin": "^\\s*(?i:#\\+begin_\\w+)\\b.*$",
          "end": "^\\s*(?i:#\\+end_\\w+)\\s*$",
          "beginCaptures": {
            "0": {
              "name": "meta.block.delimiter.org"
            }
          },
          "endCaptures": {
            "0": {
              "name": "meta.block.delimiter.org"
            }
          }
        }
      ]
    },
    "keywordLines": {
      "match": "^\\s*#\\+\\w+:.*$",
      "name": "meta.keyword-line.org"
    },
    "drawer": {
      "match": "^\\s*:[\\w-]+:(\\s+.*)?$",
      "name": "keyword.other.drawer.org"
    },
    "planning": {
      "match": "^\\s*(?:(?:SCHEDULED|DEADLINE|CLOSED):\\s*(?:<[^>]*>|\\[[^\\]]*\\])\\s*)+$",
      "captures": {
        "0": {
          "patterns": [
            {
              "include": "#planningInner"
            }
          ]
        }
      }
    },
    "planningInner": {
      "patterns": [
        {
          "match": "SCHEDULED:|DEADLINE:|CLOSED:",
          "name": "keyword.other.planning.org"
        },
        {
          "include": "#timestamp"
        }
      ]
    },
    "comment": {
      "match": "^\\s*#(\\s.*)?$",
      "name": "comment.org"
    },
    "table": {
      "match": "^\\s*\\|.*$",
      "name": "markup.other.table.org"
    },
    "inline": {
      "patterns": [
        {
          "include": "#timestamp"
        },
        {
          "match": "\\[\\[[^\\]\\n]+\\](?:\\[[^\\]\\n]*\\])?\\]",
          "name": "string.other.link.org"
        },
        {
          "match": "\\bhttps?://[^\\s\\]>)]+",
          "name": "string.other.link.org"
        },
        {
          "match": "^\\s*(?:[-+]|\\d+[.)])\\s",
          "name": "markup.list.org"
        }
      ]
    },
    "timestamp": {
      "match": "[<\\[]\\d{4}-\\d{2}-\\d{2}[^>\\]\\n]*[>\\]]",
      "name": "constant.other.timestamp.org"
    }
  }
}
