  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#5B6268"
      }
    },
    {
      "scope": [
        "comment.block.documentation",
        "string.quoted.docstring"
      ],
      "settings": {
        "foreground": "#84898e"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted"
      ],
      "settings": {
        "foreground": "#98be65"
      }
    },
    {
      "scope": [
        "string.regexp",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#4db5bd"
      }
    },
    {
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#a9a1e1"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#da8548"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#51afef"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#51afef"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#c678dd"
      }
    },
    {
      "scope": [
        "entity.name.function.member",
        "support.function.method"
      ],
      "settings": {
        "foreground": "#46D9FF"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#ECBE7B"
      }
    },
    {
      "scope": [
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#ECBE7B"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#ddaeeb"
      }
    },
    {
      "scope": [
        "variable.language",
        "support.variable"
      ],
      "settings": {
        "foreground": "#c678dd"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#51afef"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#ECBE7B"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#bbc2cf"
      }
    },
    {
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#ff6c6b"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.underline"
      ],
      "settings": {
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.strikethrough"
      ],
      "settings": {
        "fontStyle": "strikethrough"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#da8548"
      }
    },
    {
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#9ca0a4",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.list"
      ],
      "settings": {
        "foreground": "#ff6c6b"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#51afef",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#98be65"
      }
    },
    {
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#ff6c6b"
      }
    },
    {
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#da8548"
      }
    },
    {
      "scope": [
        "markup.heading.1",
        "markup.heading.1.org"
      ],
      "settings": {
        "foreground": "#51afef",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.heading.2",
        "markup.heading.2.org"
      ],
      "settings": {
        "foreground": "#c678dd",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.heading.3",
        "markup.heading.3.org"
      ],
      "settings": {
        "foreground": "#a9a1e1",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.heading.4",
        "markup.heading.4.org"
      ],
      "settings": {
        "foreground": "#7dc3f3",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.heading.5",
        "markup.heading.5.org"
      ],
      "settings": {
        "foreground": "#d49ae6",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.heading.6",
        "markup.heading.6.org"
      ],
      "settings": {
        "foreground": "#a8d7f7",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.heading.7",
        "markup.heading.7.org"
      ],
      "settings": {
        "foreground": "#e3bcee",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.heading.8",
        "markup.heading.8.org"
      ],
      "settings": {
        "foreground": "#dceffc",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#51afef",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.tag.org",
        "entity.name.tag.agenda"
      ],
      "settings": {
        "foreground": "#84898e",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "constant.other.timestamp.org",
        "constant.other.planning.org"
      ],
      "settings": {
        "foreground": "#ECBE7B",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "keyword.other.planning.org"
      ],
      "settings": {
        "foreground": "#73797e"
      }
    },
    {
      "scope": [
        "keyword.other.drawer.org",
        "meta.keyword-line.org",
        "comment.org"
      ],
      "settings": {
        "foreground": "#5B6268",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "meta.block.delimiter.org"
