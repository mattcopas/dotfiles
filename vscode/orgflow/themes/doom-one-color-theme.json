    "terminal.ansiBrightGreen": "#98be65",
    "terminal.ansiBrightYellow": "#ECBE7B",
    "terminal.ansiBrightBlue": "#51afef",
    "terminal.ansiBrightMagenta": "#c678dd",
    "terminal.ansiBrightCyan": "#46D9FF",
    "terminal.ansiBrightWhite": "#DFDFDF",
