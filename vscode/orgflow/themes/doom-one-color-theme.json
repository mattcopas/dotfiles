    "gitDecoration.addedResourceForeground": "#98be65",
    "gitDecoration.deletedResourceForeground": "#ff6c6b",
    "gitDecoration.untrackedResourceForeground": "#98be65",
    "gitDecoration.ignoredResourceForeground": "#5B6268",
    "diffEditor.insertedTextBackground": "#98be6522",
    "diffEditor.removedTextBackground": "#ff6c6b22",
    "scrollbarSlider.background": "#3f444a66",
    "scrollbarSlider.hoverBackground": "#5B626888",
    "scrollbarSlider.activeBackground": "#51afef88"
