{
  "$schema": "vscode://schemas/color-theme",
  "name": "Doom One",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "focusBorder": "#51afef",
    "foreground": "#bbc2cf",
    "descriptionForeground": "#9ca0a4",
    "errorForeground": "#ff6c6b",
    "selection.background": "#2257A0",
    "widget.shadow": "#00000066",
    "icon.foreground": "#bbc2cf",
    "editor.background": "#282c34",
    "editor.foreground": "#bbc2cf",
    "editorCursor.foreground": "#51afef",
    "editor.lineHighlightBackground": "#21242b",
    "editor.lineHighlightBorder": "#00000000",
    "editor.selectionBackground": "#42454b",
    "editor.inactiveSelectionBackground": "#3f444a",
    "editor.selectionHighlightBackground": "#3f444aaa",
    "editor.wordHighlightBackground": "#3f444aaa",
    "editor.findMatchBackground": "#ECBE7B66",
    "editor.findMatchHighlightBackground": "#ECBE7B33",
    "editorLineNumber.foreground": "#3f444a",
    "editorLineNumber.activeForeground": "#bbc2cf",
    "editorIndentGuide.background1": "#23272e",
    "editorIndentGuide.activeBackground1": "#3f444a",
    "editorWhitespace.foreground": "#3f444a",
    "editorBracketMatch.background": "#51afef33",
    "editorBracketMatch.border": "#00000000",
    "editorBracketHighlight.foreground1": "#51afef",
    "editorBracketHighlight.foreground2": "#c678dd",
    "editorBracketHighlight.foreground3": "#98be65",
    "editorBracketHighlight.foreground4": "#da8548",
    "editorBracketHighlight.foreground5": "#a9a1e1",
    "editorBracketHighlight.foreground6": "#ECBE7B",
    "editorError.foreground": "#ff6c6b",
    "editorWarning.foreground": "#ECBE7B",
    "editorInfo.foreground": "#51afef",
    "editorGutter.background": "#282c34",
    "editorGutter.modifiedBackground": "#da8548",
    "editorGutter.addedBackground": "#98be65",
    "editorGutter.deletedBackground": "#ff6c6b",
    "editorGutter.foldingControlForeground": "#5B6268",
    "editor.foldBackground": "#23272eaa",
    "editorWidget.background": "#21242b",
    "editorWidget.border": "#1c1f24",
    "editorHoverWidget.background": "#21242b",
    "editorHoverWidget.border": "#3f444a",
    "editorSuggestWidget.background": "#21242b",
    "editorSuggestWidget.border": "#1c1f24",
    "editorSuggestWidget.selectedBackground": "#3f444a",
    "editorGroup.border": "#1c1f24",
    "editorGroupHeader.tabsBackground": "#21242b",
    "editorGroupHeader.noTabsBackground": "#282c34",
    "tab.activeBackground": "#282c34",
    "tab.inactiveBackground": "#21242b",
    "tab.activeForeground": "#bbc2cf",
    "tab.inactiveForeground": "#73797e",
    "tab.border": "#1c1f24",
    "sideBar.background": "#21242b",
    "sideBar.foreground": "#bbc2cf",
    "sideBar.border": "#1c1f24",
    "sideBarTitle.foreground": "#9ca0a4",
    "sideBarSectionHeader.background": "#21242b",
    "activityBar.background": "#21242b",
    "activityBar.foreground": "#51afef",
    "activityBar.inactiveForeground": "#5B6268",
    "activityBarBadge.background": "#51afef",
    "activityBarBadge.foreground": "#1B2229",
    "list.activeSelectionBackground": "#3f444a",
    "list.activeSelectionForeground": "#DFDFDF",
    "list.inactiveSelectionBackground": "#23272e",
    "list.hoverBackground": "#23272e",
    "list.highlightForeground": "#51afef",
    "list.focusBackground": "#3f444a",
    "input.background": "#202328",
    "input.foreground": "#bbc2cf",
    "input.border": "#1c1f24",
    "input.placeholderForeground": "#5B6268",
    "dropdown.background": "#21242b",
    "button.background": "#51afef",
    "button.foreground": "#1B2229",
    "badge.background": "#51afef",
    "badge.foreground": "#1B2229",
    "quickInput.background": "#21242b",
    "quickInput.foreground": "#bbc2cf",
    "quickInputList.focusBackground": "#3f444a",
    "quickInputList.focusForeground": "#DFDFDF",
    "pickerGroup.foreground": "#51afef",
    "pickerGroup.border": "#3f444a",
    "statusBar.background": "#1e2027",
    "statusBar.foreground": "#bbc2cf",
    "statusBar.border": "#1c1f24",
    "statusBar.noFolderBackground": "#1e2027",
    "statusBar.debuggingBackground": "#da8548",
    "statusBar.debuggingForeground": "#1B2229",
    "statusBarItem.hoverBackground": "#3f444a",
    "statusBarItem.remoteBackground": "#2257A0",
