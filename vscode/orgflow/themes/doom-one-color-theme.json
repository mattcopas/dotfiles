    "titleBar.activeForeground": "#bbc2cf",
    "titleBar.inactiveBackground": "#21242b",
    "titleBar.inactiveForeground": "#5B6268",
    "titleBar.border": "#1c1f24",
    "commandCenter.background": "#282c34",
    "commandCenter.border": "#3f444a",
    "panel.background": "#282c34",
    "panel.border": "#1c1f24",
    "panelTitle.activeBorder": "#51afef",
    "panelTitle.activeForeground": "#bbc2cf",
    "panelTitle.inactiveForeground": "#5B6268",
    "terminal.background": "#282c34",
    "terminal.foreground": "#bbc2cf",
    "terminal.ansiBlack": "#1B2229",
    "terminal.ansiRed": "#ff6c6b",
    "terminal.ansiGreen": "#98be65",
    "terminal.ansiYellow": "#ECBE7B",
    "terminal.ansiBlue": "#51afef",
    "terminal.ansiMagenta": "#c678dd",
    "terminal.ansiCyan": "#46D9FF",
    "terminal.ansiWhite": "#bbc2cf",
    "terminal.ansiBrightBlack": "#5B6268",
