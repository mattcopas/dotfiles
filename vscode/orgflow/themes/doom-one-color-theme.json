        "foreground": "#98be65",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "keyword.done.agenda"
      ],
      "settings": {
        "foreground": "#5B6268",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.section.agenda"
      ],
      "settings": {
        "foreground": "#51afef",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "string.date.agenda"
      ],
      "settings": {
        "foreground": "#51afef",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "constant.other.time.agenda"
      ],
      "settings": {
        "foreground": "#ECBE7B"
      }
